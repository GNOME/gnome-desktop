#~ msgid ""
#~ "required virtual size does not fit available size: requested=(%d, %d), "
#~ "minimum=(%d, %d), maximum=(%d, %d)"
#~ msgstr ""
#~ "ukuran virtual yang diperlukan tidak sesuai dengan ukuran yang tersedia: "
#~ "dipinta=(%d, %d), minimal=(%d, %d), maksimal=(%d, %d)"

