#: libgnome-desktop/gnome-desktop-thumbnail.c:1035
#, c-format
msgid "File %s does not have a preview icon attribute"
msgstr "Filen %s har inget attribut för förhandsgranskningsikon"

#: libgnome-desktop/gnome-desktop-thumbnail.c:1045
#, c-format
msgid "No loadable icon for %s"
msgstr "Ingen inläsningsbar ikon för %s"

#: libgnome-desktop/gnome-desktop-thumbnail.c:1178
#, c-format
msgid "Could not find thumbnailer for mime-type '%s'"
msgstr "Kunde inte hitta miniatyrbildsskapare för mimetypen ”%s”"

#: libgnome-desktop/gnome-desktop-thumbnail.c:1308
#, c-format
msgid "Failed to create folder '%s'"
msgstr "Misslyckades med att skapa mappen ”%s”"

