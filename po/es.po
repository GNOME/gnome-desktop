#: libgnome-desktop/gnome-desktop-thumbnail.c:1035
#, c-format
msgid "File %s does not have a preview icon attribute"
msgstr "El archivo %s no tiene un atributo de icono de vista previa"

#: libgnome-desktop/gnome-desktop-thumbnail.c:1045
#, c-format
msgid "No loadable icon for %s"
msgstr "No hay icono para %s"

#: libgnome-desktop/gnome-desktop-thumbnail.c:1178
#, c-format
msgid "Could not find thumbnailer for mime-type '%s'"
msgstr "No se pudo encontrar el generador de miniaturas para el tipo MIME «%s»"

#: libgnome-desktop/gnome-desktop-thumbnail.c:1308
#, c-format
msgid "Failed to create folder '%s'"
msgstr "Falló al crear la carpeta «%s»"

#: libgnome-desktop/gnome-desktop-thumbnail.c:1321
#, c-format
msgid "The output folder '%s' is not writable"
msgstr "No se puede escribir en la carpeta de salida «%s»"

#: libgnome-desktop/gnome-languages.c:700
msgid "Unspecified"
msgstr "Sin especificar"

#. TRANSLATORS: Used to distinguish the labels representing the gez_ER
#. and gez_ET locales from gez_ER@abegede respective gez_ET@abegede. The
#. difference is related to collation.
#: libgnome-desktop/gnome-languages.c:1366
msgid "Abegede"
msgstr "Abegede"

#. TRANSLATORS: Used to distinguish Cyrillic from Latin written language
#. variants.
#: libgnome-desktop/gnome-languages.c:1368
msgid "Cyrillic"
msgstr "Cirílico"

#. TRANSLATORS: Also known as "Nagari", a written variant for many languages
#. of the Indian subcontinent. See:
#. https://en.wikipedia.org/wiki/Devanagari
#: libgnome-desktop/gnome-languages.c:1372
msgid "Devanagari"
msgstr "Devanagari"

#. TRANSLATORS: Used to distinguish the label representing the tt_RU
#. locale from tt_RU@iqtelif. It's a special alphabet for Tatar.
#: libgnome-desktop/gnome-languages.c:1375
msgid "IQTElif"
msgstr "IQTElif"

#. TRANSLATORS: The alphabet/script, not the language. Used to distinguish
#. Latin from Cyrillic written language variants.
#: libgnome-desktop/gnome-languages.c:1378
msgid "Latin"
msgstr "Latino"

#. TRANSLATORS: "Saho" is a variant of the Afar language. Used to
#. distinguish the label representing the aa_ER locale from aa_ER@saaho.
#: libgnome-desktop/gnome-languages.c:1381
msgid "Saho"
msgstr "Saho"

#. TRANSLATORS: "Valencia" is a dialect of the Catalan language spoken
#. in Valencia. Used to distinguish the label representing the ca_ES
#. locale from ca_ES@valencia.
#: libgnome-desktop/gnome-languages.c:1385
msgid "Valencia"
msgstr "Valenciano"

# R:S hora:min
# e numero de dia
# b mes
# a dia
#. Translators: This is the time format with full date
#. plus day used in 24-hour mode. Please keep the under-
#. score to separate the date from the time.
#: libgnome-desktop/gnome-wall-clock.c:337
msgid "%a %b %-e_%R:%S"
msgstr "%a %-e de %b_%R:%S"

#: libgnome-desktop/gnome-wall-clock.c:338
msgid "%a %b %-e_%R"
msgstr "%a %-e de %b_%R"

#. Translators: This is the time format with full date
#. used in 24-hour mode. Please keep the underscore to
#. separate the date from the time.
#: libgnome-desktop/gnome-wall-clock.c:343
msgid "%b %-e_%R:%S"
msgstr "%-e de %b_%R:%S"

#: libgnome-desktop/gnome-wall-clock.c:344
msgid "%b %-e_%R"
msgstr "%-e de %b_%R"

#. Translators: This is the time format with day used
#. in 24-hour mode.
#: libgnome-desktop/gnome-wall-clock.c:348
msgid "%a %R:%S"
msgstr "%a %R:%S"

#: libgnome-desktop/gnome-wall-clock.c:349
msgid "%a %R"
msgstr "%a %R"

#. Translators: This is the time format without date used
#. in 24-hour mode.
#: libgnome-desktop/gnome-wall-clock.c:353
msgid "%R:%S"
msgstr "%R:%S"

#: libgnome-desktop/gnome-wall-clock.c:354
msgid "%R"
msgstr "%R"

#. Translators: This is a time format with full date
#. plus day used for AM/PM. Please keep the under-
#. score to separate the date from the time.
#: libgnome-desktop/gnome-wall-clock.c:362
msgid "%a %b %-e_%l:%M:%S %p"
msgstr "%a %-e de %b_%l:%M:%S %p"

#: libgnome-desktop/gnome-wall-clock.c:363
msgid "%a %b %-e_%l:%M %p"
msgstr "%a %-e de %b_%l:%M %p"

#. Translators: This is a time format with full date
#. used for AM/PM. Please keep the underscore to
#. separate the date from the time.
#: libgnome-desktop/gnome-wall-clock.c:368
msgid "%b %-e_%l:%M:%S %p"
msgstr "%-e de %b_%l:%M:%S %p"

#: libgnome-desktop/gnome-wall-clock.c:369
msgid "%b %-e_%l:%M %p"
msgstr "%-e de %b_%l:%M %p"

#. Translators: This is a time format with day used
#. for AM/PM.
#: libgnome-desktop/gnome-wall-clock.c:373
msgid "%a %l:%M:%S %p"
msgstr "%a %l:%M:%S %p"

#: libgnome-desktop/gnome-wall-clock.c:374
msgid "%a %l:%M %p"
msgstr "%a %l:%M %p"

#. Translators: This is a time format without date used
#. for AM/PM.
#: libgnome-desktop/gnome-wall-clock.c:378
msgid "%l:%M:%S %p"
msgstr "%l:%M:%S %p"

#: libgnome-desktop/gnome-wall-clock.c:379
msgid "%l:%M %p"
msgstr "%l:%M %p"

#: libgnome-desktop/gnome-qr-gtk/gnome-qr-widget.c:267
